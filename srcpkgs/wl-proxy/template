do_install() {
	for bin in \
		log-dmabuf-feedback \
		window-to-tray \
		wl-cm-filter \
		wl-format-filter \
		wl-paper \
		wl-veil
	do
		vbin "target/${RUST_TARGET}/release/${bin}"
	done
}
